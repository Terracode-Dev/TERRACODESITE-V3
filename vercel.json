{
  "redirects": [
    { "source": "/policies/privacy-policy.html", "destination": "/privacy-policy", "permanent": true },
    { "source": "/policies/terms-conditions.html", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/policies/refund-policy.html", "destination": "/refund-policy", "permanent": true },
    { "source": "/policies/privacy-policy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/policies/terms-conditions", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/policies/refund-policy", "destination": "/refund-policy", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-and-conditions.html"
    },
    {
      "source": "/refund-policy",
      "destination": "/refund-policy.html"
    },
    { "source": "/policies/cookie-policy", "destination": "/policies/cookie-policy.html" },
    { "source": "/policies/data-processing-agreement-dpa", "destination": "/policies/data-processing-agreement-dpa.html" },
    { "source": "/policies/disclaimer-policy", "destination": "/policies/disclaimer-policy.html" },
    { "source": "/policies/end-user-license-agreement-eula", "destination": "/policies/end-user-license-agreement-eula.html" },
    { "source": "/policies/service-level-agreement-sla", "destination": "/policies/service-level-agreement-sla.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/payments", "destination": "/payments.html" },
    { "source": "/t&s", "destination": "/t&s.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://img.youtube.com https://i.ytimg.com https://www.google-analytics.com; font-src 'self' data:; connect-src 'self' https://terracodedev.com https://payment.terracodedev.com https://api.emailjs.com https://www.google-analytics.com https://region1.google-analytics.com; frame-src 'self' https://www.payhere.lk https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com; form-action 'self' https://www.payhere.lk;"
        }
      ]
    }
  ]
}
